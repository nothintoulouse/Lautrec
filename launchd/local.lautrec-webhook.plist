<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Placeholders {{PYTHON}} {{PROJECT_ROOT}} {{HOME}} are substituted by
     launchd/install.sh. Do not load this template directly. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.lautrec-webhook</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{PROJECT_ROOT}}/webhook.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{PROJECT_ROOT}}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>
    <key>StandardOutPath</key>
    <string>{{PROJECT_ROOT}}/logs/webhook.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{PROJECT_ROOT}}/logs/webhook.err.log</string>
</dict>
</plist>
